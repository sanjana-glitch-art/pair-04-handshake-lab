# Pair 4 Handshake - application service (applications; publishes application.created/updated/status_changed).
# Build from backend/:  docker build -f docker/Dockerfile.application -t p4-application-service:2.0 .
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    SERVICE_NAME=application \
    SERVICE_PORT=9044

WORKDIR /srv

# Only this service's dependencies (no test or migration packages).
COPY requirements/ requirements/
RUN pip install --no-cache-dir -r requirements/base.txt

COPY app/ app/

RUN useradd --create-home --uid 10001 handshake
USER handshake

EXPOSE 9044

HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:9044/health', timeout=2).status == 200 else 1)"

CMD ["sh", "-c", "uvicorn app.services.application:app --host 0.0.0.0 --port ${SERVICE_PORT} --workers ${UVICORN_WORKERS:-2}"]
