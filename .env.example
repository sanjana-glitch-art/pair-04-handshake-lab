PAIR=4
PORT_BASE=9040
DB_PREFIX=p4
SEED=4

# MongoDB (Docker Compose publishes it on 27047; containers use p4-mongo:27017)
MONGO_USER=p4admin
MONGO_PASSWORD=change_me
MONGO_HOST=localhost
MONGO_PORT=27047
MONGO_DATABASE=p4_handshake

# Kafka (host listener; containers use p4-kafka:9092)
KAFKA_BOOTSTRAP_SERVERS=localhost:9047
KAFKA_ENABLED=true

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_THINK=true

JWT_SECRET_KEY=replace_with_a_secret_key

# Only for database/migrate_mysql_to_mongo.py (reads the Lab 1 MySQL database)
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=p4_handshake
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
